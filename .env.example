# Copy to .env or export in shell. Never commit real keys.
# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, local vLLM, etc.)
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Examples:
#   DeepSeek:  OPENAI_BASE_URL=https://api.deepseek.com  OPENAI_MODEL=deepseek-chat
#   Local:     OPENAI_BASE_URL=http://localhost:8000/v1  OPENAI_MODEL=local-model
# DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL are kept as fallback.
# Workspace the agent may read/write/run in (defaults to cwd)
CW_WORKSPACE=.
# Headless auto-approve write/bash tools (default: false -> deny write/bash unless --yes)
CW_AUTO_APPROVE=false

# LAN access token for --web (recommended when exposing beyond localhost)
CW_TOKEN=
