# Copy to .env or export in shell. Never commit real keys.
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Workspace the agent may read/write/run in (defaults to cwd)
CW_WORKSPACE=.
# Headless auto-approve write/bash tools (default: false -> deny write/bash unless --yes)
CW_AUTO_APPROVE=false
