{
  "name": "personal",
  "description": "Personal profile: fs + shell + tools + llm(openai-compatible|mock) + loop + projects + todo + compaction",
  "home": ".code-worker",
  "plugins": [
    "session",
    "file-cache",
    "tools",
    "path-policy",
    "fs-local",
    "tool-fs",
    "shell-local",
    "tool-bash",
    "projects",
    "project-env",
    "todo",
    "skills",
    "agents",
    "outputs",
    "terminals",
    "tool-terminal",
    "settings",
    "model-config",
    "llm",
    "compaction",
    "project-isolation",
    "title-generator",
    "agent-loop",
    "guard-approval"
  ],
  "config": {
    "workspace": ".",
    "plugins": {
      "agent-loop": {
        "maxSteps": 8,
        "toolResultMaxBytes": 20000
      },
      "compaction": {
        "maxContextChars": 60000,
        "pruneBytes": 2000,
        "keepRecent": 4
      },
      "guard-approval": {
        "guardedTools": [
          "write_file",
          "bash",
          "report_write",
          "skill_load",
          "terminal_open",
          "terminal_send",
          "terminal_read",
          "terminal_kill"
        ]
      }
    }
  }
}
