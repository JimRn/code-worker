{
  "name": "personal",
  "description": "Personal profile: fs + shell + tools + llm(openai-compatible|mock) + loop + projects + todo + compaction",
  "home": ".code-worker",
  "plugins": [
    "session",
    "tools",
    "fs-local",
    "tool-fs",
    "shell-local",
    "tool-bash",
    "todo",
    "projects",
    "settings",
    "llm",
    "compaction",
    "project-isolation",
    "title-generator",
    "agent-loop",
    "guard-approval"
  ],
  "config": {
    "workspace": ".",
    "maxSteps": 8,
    "toolResultMaxBytes": 20000,
    "guardedTools": ["write_file", "bash"],
    "compaction": {
      "maxContextChars": 60000,
      "pruneBytes": 2000,
      "keepRecent": 4
    }
  }
}
